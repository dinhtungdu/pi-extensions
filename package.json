{
	"name": "pi-extensions",
	"version": "0.1.1",
	"description": "Pi extensions for macOS themes, Codemode orchestration, persisted goals, and local hands-free voice.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dinhtungdu/pi-extensions.git"
	},
	"homepage": "https://github.com/dinhtungdu/pi-extensions#readme",
	"bugs": {
		"url": "https://github.com/dinhtungdu/pi-extensions/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"theme",
		"dark-mode",
		"codemode",
		"goal",
		"voice",
		"speech-to-text",
		"text-to-speech"
	],
	"pi": {
		"extensions": [
			"./extensions/auto-dark-mode.ts",
			"./extensions/code-mode.ts",
			"./extensions/goal.ts",
			"./extensions/tool-visibility/index.ts",
			"./extensions/voice/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.82.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-tui": "^0.83.0",
		"@types/node": "^24.13.3",
		"typebox": "^1.3.8",
		"typescript": "^5.8.3"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test:tool-visibility": "node ./scripts/test-tool-visibility.mjs",
		"setup:voice": "node ./scripts/setup-voice.mjs",
		"uninstall:voice": "node ./scripts/uninstall-voice.mjs",
		"test:voice": "node ./scripts/test-voice.mjs",
		"test:voice-cleanup": "node ./scripts/test-voice-preprocessor.mjs",
		"test:voice-input-mode": "node ./scripts/test-voice-input-mode.mjs",
		"test:voice-components": "node ./scripts/test-voice-components.mjs"
	}
}
