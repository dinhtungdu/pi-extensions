{
	"name": "pi-extensions",
	"version": "0.1.1",
	"description": "Pi extensions for macOS themes, Codemode orchestration, persisted goals, OpenAI Codex fast mode, Discord bridging, and local hands-free voice.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dinhtungdu/pi-extensions.git"
	},
	"homepage": "https://github.com/dinhtungdu/pi-extensions#readme",
	"bugs": {
		"url": "https://github.com/dinhtungdu/pi-extensions/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"theme",
		"dark-mode",
		"codemode",
		"goal",
		"openai-codex",
		"fast-mode",
		"discord",
		"voice",
		"speech-to-text",
		"text-to-speech"
	],
	"pi": {
		"extensions": [
			"./extensions/auto-dark-mode.ts",
			"./extensions/code-mode.ts",
			"./extensions/goal.ts",
			"./extensions/codex-fast.ts",
			"./extensions/discord/index.ts",
			"./extensions/tool-visibility/index.ts",
			"./extensions/voice/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-tui": "^0.83.0",
		"@types/node": "^24.13.3",
		"oxlint": "^1.76.0",
		"typebox": "^1.3.8",
		"typescript": "^5.8.3"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "oxlint extensions/codex-fast.ts extensions/discord scripts/test-codex-fast.mjs scripts/test-discord*.mjs scripts/fixtures/discord-*.mjs",
		"test:codex-fast": "node ./scripts/test-codex-fast.mjs",
		"test:discord": "node ./scripts/test-discord-config.mjs && node ./scripts/test-discord-wake-warning.mjs && node ./scripts/test-discord-bridge.mjs && node ./scripts/test-discord-relay-child.mjs",
		"test:discord-wake-warning": "node ./scripts/test-discord-wake-warning.mjs",
		"test:tool-visibility": "node ./scripts/test-tool-visibility.mjs",
		"setup:voice": "node ./scripts/setup-voice.mjs",
		"uninstall:voice": "node ./scripts/uninstall-voice.mjs",
		"test:voice": "node ./scripts/test-voice.mjs",
		"test:voice-cleanup": "node ./scripts/test-voice-preprocessor.mjs",
		"test:voice-input": "node ./scripts/test-voice-input.mjs",
		"test:voice-status": "node ./scripts/test-voice-status.mjs",
		"test:voice-components": "node ./scripts/test-voice-components.mjs"
	},
	"dependencies": {
		"discord.js": "^14.27.0",
		"jiti": "^2.7.0"
	}
}
